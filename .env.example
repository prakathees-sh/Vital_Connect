# ===============================================
# VITAL CONNECT — Environment Configuration
# Intelligent Emergency Blood Coordination Platform
# ===============================================

# --- Backend Configuration ---
PROJECT_NAME="Vital Connect"
VERSION="2.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="vital-connect-emergency-secret-key-2026-secure-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Connection
DATABASE_URL="postgresql://vital@localhost:5432/vital_connect"

# Server Host & Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1/chat/ws"
PORT=3000

# --- SMS & Communication Gateways (Optional Provider Keys) ---
SMS_GATEWAY_PROVIDER="simulation"
SMS_API_KEY="your_sms_api_key_here"
EMAIL_SMTP_HOST="smtp.vitalconnect.org"
